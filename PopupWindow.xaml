<Window x:Class="sistecDesktop.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sistecDesktop"
        xmlns:viewsPopups="clr-namespace:sistecDesktop.Views.Popups"
        xmlns:viewModels="clr-namespace:sistecDesktop.ViewModels"
        xmlns:converters="clr-namespace:sistecDesktop.Converters"
        mc:Ignorable="d"
        Title="PopupWindow" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Height="800" Width="800">

    <Window.Resources>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:EnableRestoreConverter x:Key="EnableRestoreConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InverseBoolToEnableConverter x:Key="InverseBoolToEnableConverter"/>


        <DataTemplate DataType="{x:Type viewModels:OpenTicketViewModel}">
            <viewsPopups:OpenTicketView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:MyTicketsViewModel}">
            <viewsPopups:MyTicketsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ApproveTicketsViewModel}">
            <viewsPopups:ApproveTicketsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:UserCreateViewModel}">
            <viewsPopups:UserCreateView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="White">
        <ContentPresenter Content="{Binding}" />
    </Grid>
</Window>
