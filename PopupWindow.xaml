<Window x:Class="sistecDesktop.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sistecDesktop"
        xmlns:viewsPopups="clr-namespace:sistecDesktop.Views.Popups"
        xmlns:viewModels="clr-namespace:sistecDesktop.ViewModels"
        mc:Ignorable="d"
        Title="PopupWindow" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Height="450" Width="800">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:OpenTicketViewModel}">
            <viewsPopups:OpenTicketView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:MyTicketsViewModel}">
            <viewsPopups:MyTicketsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="White">
        <ContentPresenter Content="{Binding}" />
    </Grid>
</Window>
