<UserControl x:Class="sistecDesktop.Views.Popups.UserProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:sistecDesktop.Views.Popups"
             xmlns:viewModels="clr-namespace:sistecDesktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid>
        <Border
            Background="{DynamicResource brush-lavenderMist}"
            BorderBrush="{DynamicResource brush-frenchGray}"
            BorderThickness="1" CornerRadius="8"
            HorizontalAlignment="Stretch"
            Margin="10 10 10 10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!--#region Título-->
                <Border Grid.Row="0" CornerRadius="8 8 0 0" Padding="10"
                        Background="{StaticResource brush-midnightNavy}"
                        BorderThickness="0">

                    <TextBlock Text="Gerenciar Usuário" FontSize="24" Margin="0 10 0 10"
                        FontFamily="{StaticResource MontserratBold}"
                        Foreground="{StaticResource brush-White}"/>
                </Border>
                <!--#endregion-->

                <!--#region Dados Pessoais-->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Dados Pessoais" FontSize="16" Margin="10" Grid.Row="0"
                        FontFamily="{StaticResource MontserratBold}"/>

                    <!--#region Nome-->
                    <TextBlock Text="Nome" Margin="10 0 0 0" Grid.Row="1"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtNome" Grid.Row="2" Margin="10 5 10 5"/>
                    <!--#endregion-->

                    <!--#region Sobrenome-->
                    <TextBlock Text="Sobrenome" Margin="10 0 0 0" Grid.Row="1" Grid.Column="1"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtSobrenome" Grid.Row="2" Grid.Column="1" Margin="10 5 10 5"/>
                    <!--#endregion-->
                </Grid>
                <!--#endregion-->

                <!--#region Contato-->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Contato" FontSize="16" Margin="10" Grid.Row="0"
                        FontFamily="{StaticResource MontserratBold}"/>

                    <!--#region Email-->
                    <TextBlock Text="Email" Margin="10 0 0 0" Grid.Row="1"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtEmail" Grid.Row="2" Margin="10 5 10 5"/>
                    <!--#endregion-->

                    <!--#region Telefone-->
                    <TextBlock Text="Telefone" Margin="10 0 0 0" Grid.Row="1" Grid.Column="1"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtTelefone" Grid.Row="2" Grid.Column="1" Margin="10 5 10 5"/>
                    <!--#endregion-->
                    
                    <!--#region Ramal-->
                    <TextBlock Text="Ramal(Opcional)" Margin="10 0 0 0" Grid.Row="1" Grid.Column="2"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtRamal" Grid.Row="2" Grid.Column="2" Margin="10 5 10 5"/>
                    <!--#endregion-->
                </Grid>
                <!--#endregion-->

                <!--#region Informações Profissionais-->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Informações Profissionais" FontSize="16" Margin="10" Grid.Row="0"
                        FontFamily="{StaticResource MontserratBold}"/>

                    <!--#region Cargo-->
                    <TextBlock Text="Cargo/ Função" Margin="10 0 0 0" Grid.Row="1"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtCargo" Grid.Row="2" Margin="10 5 10 5"/>
                    <!--#endregion-->

                    <!--#region Setor-->
                    <TextBlock Text="Setor/ Departamento" Margin="10 0 0 0" Grid.Row="1" Grid.Column="1"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtSetor" Grid.Row="2" Grid.Column="1" Margin="10 5 10 5"/>
                    <!--#endregion-->
                    
                    <!--#region Nível de Acesso-->
                    <TextBlock Text="Nível de Acesso" Margin="10 0 0 0" Grid.Row="3" 
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtNivelAcesso" Grid.Row="4" Margin="10 5 10 5"/>
                    <!--#endregion-->
                    
                    <!--#region Senha-->
                    <TextBlock Text="Senha" Margin="10 0 0 0" Grid.Row="3" Grid.Column="1"
                        FontFamily="{StaticResource MontserratRegular}"/>

                    <TextBox x:Name="txtSenha" Grid.Row="4" Grid.Column="1" Margin="10 5 10 5"/>
                    <!--#endregion-->
                    
                    
                </Grid>
                <!--#endregion-->

                <!--#region Botões-->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="10"
                            HorizontalAlignment="Right">
                    
                    <Button x:Name="btnCancelar" Content="Cancelar"
                            Style="{StaticResource HomeButtons}"
                            Width="100" Height="50"/>
                    
                    <Button x:Name="btnSalvar" Content="Salvar"
                            Style="{StaticResource HomeButtons}"
                            Width="100" Height="50"/>
                </StackPanel>
                <!--#endregion-->
            </Grid>
        </Border>
    </Grid>
</UserControl>
