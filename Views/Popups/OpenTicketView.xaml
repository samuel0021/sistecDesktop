<UserControl x:Class="sistecDesktop.Views.Popups.OpenTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:sistecDesktop.Views.Popups"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título do Popup -->
        <TextBlock Grid.Row="0" 
                   Text="Novo Chamado" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Campo Título -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Título:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"/>
        </StackPanel>

        <!-- Grid com Prioridade e Categoria lado a lado -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Prioridade -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Prioridade:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox SelectedValue="{Binding Priority}"
                          SelectedValuePath="Tag"
                          Height="30">
                    <ComboBoxItem Content="Baixa" Tag="1"/>
                    <ComboBoxItem Content="Média" Tag="2"/>
                    <ComboBoxItem Content="Alta" Tag="3"/>
                    <ComboBoxItem Content="Urgente" Tag="4"/>
                </ComboBox>
            </StackPanel>

            <!-- Categoria -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Categoria:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox SelectedValue="{Binding CategoriaSelecionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
           SelectedValuePath="Tag"
           IsSynchronizedWithCurrentItem="True"
           Height="30">
                    <ComboBoxItem Content="Hardware" Tag="hardware"/>
                    <ComboBoxItem Content="Software" Tag="software"/>
                    <ComboBoxItem Content="Rede" Tag="rede"/>
                    <ComboBoxItem Content="Acesso" Tag="acesso"/>
                    <ComboBoxItem Content="Email" Tag="email"/>
                    <ComboBoxItem Content="Outros" Tag="outros"/>
                </ComboBox>
            </StackPanel>

        </Grid>
        <!-- Problema - atualiza automaticamente -->
        <StackPanel Grid.Row="3">
                <TextBlock Text="Problema:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ProblemasDisponiveis}"
              SelectedValue="{Binding ProblemaSelecionado}"
              DisplayMemberPath="Label"
              SelectedValuePath="Value"
              Height="30">
                </ComboBox>
            </StackPanel>

            <!-- Campo Descrição -->
            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Descrição:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Mensagem de erro -->
            <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

            <!-- Botões -->
            <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
                <Button Content="Cancelar" 
                    Width="100" 
                    Height="35"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"/>
                <Button Content="Criar Chamado" 
                    Width="120" 
                    Height="35"
                    Background="#4CAF50"
                    Foreground="White"
                    Command="{Binding CreateTicketCommand}"/>
            </StackPanel>
        </Grid>
</UserControl>
