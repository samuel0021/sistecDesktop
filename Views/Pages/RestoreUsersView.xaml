<UserControl x:Class="sistecDesktop.Views.Pages.RestoreUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:sistecDesktop.Views.Pages"
             xmlns:converters="clr-namespace:sistecDesktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:EnableRestoreConverter x:Key="EnableRestoreConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <!-- Barra superior com título, busca e atualizar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Usuários Deletados" 
                       FontSize="22" FontWeight="Bold" Margin="0,0,28,0" VerticalAlignment="Center"/>
            <TextBox Width="220"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Atualizar"
                    Width="100"
                    VerticalAlignment="Center"
                    Command="{Binding ReloadCommand}"/>
        </StackPanel>

        <!-- Estado de carregamento -->
        <ProgressBar Height="4" IsIndeterminate="True"
                     VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Mensagem de erro -->
        <TextBlock Text="{Binding Error}"
                   Foreground="Red"
                   Margin="5,34,5,7"
                   FontWeight="Bold"
                   Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding UsuariosDeletados}" AutoGenerateColumns="False"
                  Margin="0,50,0,0"
                  SelectedItem="{Binding SelectedBackup}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Motivo Deleção" Binding="{Binding MotivoDelecao}" Width="200"/>
                <DataGridTextColumn Header="Deletado por" Binding="{Binding UsuarioQueDeletou}" Width="150"/>
                <DataGridTextColumn Header="Data" Binding="{Binding DataDelecao, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusBackup}" Width="90"/>
                <DataGridTemplateColumn Header="Restauração" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Restaurar"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding StatusBackup, Converter={StaticResource EnableRestoreConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
