<UserControl x:Class="sistecDesktop.Views.Pages.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:sistecDesktop.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!--<ScrollViewer>
            <StackPanel>
                <TextBlock Text="Bem-vindo!" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Selecione uma opção no menu" FontSize="16" Margin="0 10 0 0"/>
            </StackPanel>
        </ScrollViewer>-->

        <!--#region Definições do Grid-->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--#endregion-->


        <!--#region Abrir Chamado -->
        <Button x:Name="btnAbrirChamado" Grid.Column="0"
                Style="{StaticResource HomeButtons}"
                Background="{StaticResource brush-mistyRose}"
                HorizontalContentAlignment="Stretch">

            <DockPanel>

                <TextBlock Text="Abrir Chamado" Margin="15" FontSize="14"
                           VerticalAlignment="Center"/>

                <Border BorderThickness="0" Margin="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource brush-lavenderMist}"
                        CornerRadius="5">

                    <Image Source="/images/plus.png"
                           HorizontalAlignment="Center"
                           Height="40" Width="40"/>
                </Border>

            </DockPanel>
        </Button>
        <!--#endregion-->

        <!--#region Meus Chamados -->
        <Button x:Name="btnMeusChamados" Grid.Column="1"
                Style="{StaticResource HomeButtons}"
                Background="{StaticResource brush-lavenderMist}"
                HorizontalContentAlignment="Stretch">
            
            <DockPanel>

                <TextBlock Text="Meus Chamados" Margin="15" FontSize="14"
                           VerticalAlignment="Center"/>

                <Border BorderThickness="0" Margin="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource brush-mistyRose}"
                        CornerRadius="5">

                    <Image Source="/images/user-orange.png"
                           HorizontalAlignment="Center"
                           Height="40" Width="40"/>
                </Border>

            </DockPanel>

        </Button>
        <!--#endregion-->

        <!--#region Meus Chamados -->
        <Button x:Name="btnAprovarChamados" Grid.Column="2"
                Style="{StaticResource HomeButtons}"
                Background="{StaticResource brush-lavenderMist}"
                HorizontalContentAlignment="Stretch">

            <DockPanel>

                <TextBlock Text="Aprovar Chamados" Margin="15" FontSize="14"
                           VerticalAlignment="Center"/>

                <Border BorderThickness="0" Margin="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource brush-mistyRose}"
                        CornerRadius="5">

                    <Image Source="/images/check.png"
                           HorizontalAlignment="Center"
                           Height="40" Width="40"/>
                </Border>

            </DockPanel>
        </Button>
        <!--#endregion-->

        <DataGrid Grid.Row="1" Grid.ColumnSpan="3">
            
        </DataGrid>

    </Grid>

</UserControl>
