<Window x:Class="sistecDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sistecDesktop"
        mc:Ignorable="d"
        xmlns:viewmodels="clr-namespace:sistecDesktop.ViewModels"
        Title="Sistec" Height="720" Width="1280" 
        Loaded="Window_Loaded"
        MaxHeight="1080" MaxWidth="1920"
        Background="Transparent"
        WindowStartupLocation="CenterScreen" 
        
        ResizeMode="CanResizeWithGrip"
        Icon="/images/logo-purple.ico"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel, IsDesignTimeCreatable=False}">

    <Grid>
        <!-- Apenas um ContentControl que mostra o SelectedViewModel -->
        <ContentControl Content="{Binding SelectedViewModel}"/>
    </Grid>
    
</Window>
